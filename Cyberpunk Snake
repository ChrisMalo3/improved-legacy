<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Neon Cyberpunk Snake</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;700&display=swap');

        body {
            background-color: #050505;
            font-family: 'Orbitron', sans-serif;
            color: #e0e0e0;
            overflow: hidden;
            touch-action: none; /* Prevent scroll on mobile */
        }

        /* Cyberpunk Grid Background */
        .cyber-grid {
            background-image: 
                linear-gradient(rgba(0, 255, 255, 0.05) 1px, transparent 1px),
                linear-gradient(90deg, rgba(0, 255, 255, 0.05) 1px, transparent 1px);
            background-size: 20px 20px;
            box-shadow: inset 0 0 100px rgba(0, 0, 0, 0.9);
        }

        .game-container {
            box-shadow: 0 0 20px rgba(0, 255, 255, 0.2), 
                        inset 0 0 20px rgba(0, 255, 255, 0.1);
            border: 2px solid #0ff;
            position: relative;
        }

        .neon-text {
            text-shadow: 0 0 5px #0ff, 0 0 10px #0ff, 0 0 20px #0ff;
        }

        .neon-text-green {
            text-shadow: 0 0 5px #39ff14, 0 0 10px #39ff14;
            color: #39ff14;
        }

        .scanline {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: linear-gradient(to bottom, transparent 50%, rgba(0, 0, 0, 0.3) 51%);
            background-size: 100% 4px;
            pointer-events: none;
            z-index: 10;
            opacity: 0.3;
        }

        /* Mobile D-Pad */
        .d-pad-btn {
            background: rgba(0, 255, 255, 0.1);
            border: 1px solid #0ff;
            color: #0ff;
            backdrop-filter: blur(4px);
            active: background: rgba(0, 255, 255, 0.3);
        }
        
        canvas {
            display: block;
            background-color: rgba(0, 0, 0, 0.6);
        }
    </style>
</head>
<body class="cyber-grid h-screen w-screen flex flex-col items-center justify-center">

    <!-- CRT Scanline Effect -->
    <div class="scanline"></div>

    <!-- UI Header -->
    <div class="w-full max-w-md flex justify-between items-end mb-4 px-4 z-20">
        <div>
            <h1 class="text-2xl font-bold neon-text tracking-wider">NEO-SNAKE</h1>
            <p class="text-xs text-cyan-700 tracking-widest">SYS.V.2.0</p>
        </div>
        <div class="text-right">
            <p class="text-sm text-gray-400">SCORE</p>
            <p id="score" class="text-3xl font-bold neon-text-green">0</p>
        </div>
    </div>

    <!-- Game Board -->
    <div class="relative z-20">
        <div class="game-container rounded-lg overflow-hidden">
            <canvas id="gameCanvas" width="400" height="400"></canvas>
            
            <!-- Game Over Overlay -->
            <div id="gameOverScreen" class="hidden absolute inset-0 bg-black/80 flex flex-col items-center justify-center z-30">
                <h2 class="text-4xl font-bold text-red-500 text-shadow-red mb-2" style="text-shadow: 0 0 10px red;">CRASHED</h2>
                <p class="text-cyan-300 mb-6">SYSTEM FAILURE</p>
                <button onclick="resetGame()" class="px-6 py-2 border border-green-500 text-green-500 hover:bg-green-500 hover:text-black transition-all font-bold tracking-widest uppercase shadow-[0_0_15px_rgba(57,255,20,0.5)]">
                    Reboot
                </button>
            </div>

            <!-- Start Overlay -->
            <div id="startScreen" class="absolute inset-0 bg-black/80 flex flex-col items-center justify-center z-30">
                <h2 class="text-3xl font-bold text-cyan-400 neon-text mb-4">READY?</h2>
                <p class="text-gray-400 text-sm mb-6 text-center px-4">Use Arrow Keys, WASD, or Swipe</p>
                <button onclick="startGame()" class="px-6 py-2 border border-cyan-500 text-cyan-500 hover:bg-cyan-500 hover:text-black transition-all font-bold tracking-widest uppercase shadow-[0_0_15px_rgba(0,255,255,0.5)]">
                    Initialize
                </button>
            </div>
        </div>
    </div>

    <!-- Mobile Controls (Visible only on touch devices roughly) -->
    <div class="mt-6 grid grid-cols-3 gap-2 md:hidden z-20">
        <div></div>
        <button class="d-pad-btn w-12 h-12 rounded-lg flex items-center justify-center text-xl font-bold" onclick="handleMobileInput('ArrowUp')">▲</button>
        <div></div>
        <button class="d-pad-btn w-12 h-12 rounded-lg flex items-center justify-center text-xl font-bold" onclick="handleMobileInput('ArrowLeft')">◀</button>
        <button class="d-pad-btn w-12 h-12 rounded-lg flex items-center justify-center text-xl font-bold" onclick="handleMobileInput('ArrowDown')">▼</button>
        <button class="d-pad-btn w-12 h-12 rounded-lg flex items-center justify-center text-xl font-bold" onclick="handleMobileInput('ArrowRight')">▶</button>
    </div>

    <div class="hidden md:block mt-4 text-xs text-gray-500 z-20">
        [ARROWS] or [WASD] to Move
    </div>

    <script>
        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas.getContext('2d');
        const scoreEl = document.getElementById('score');
        const gameOverScreen = document.getElementById('gameOverScreen');
        const startScreen = document.getElementById('startScreen');

        // Game Config
        const gridSize = 20;
        const tileCount = canvas.width / gridSize;
        let gameSpeed = 100; // Lower is faster
        
        // Game State
        let score = 0;
        let velocity = { x: 0, y: 0 };
        let trail = [];
        let tailLength = 5;
        let player = { x: 10, y: 10 };
        let apple = { x: 15, y: 15 };
        let gameInterval;
        let isGameRunning = false;

        // Input Buffer to prevent 180 degree turns in one tick
        let lastVelocity = { x: 0, y: 0 };

        // Mobile Swipe Detection
        let touchStartX = 0;
        let touchStartY = 0;

        document.addEventListener('keydown', keyPush);
        
        // Touch Listeners
        document.addEventListener('touchstart', e => {
            touchStartX = e.changedTouches[0].screenX;
            touchStartY = e.changedTouches[0].screenY;
        }, {passive: false});

        document.addEventListener('touchend', e => {
            if(!isGameRunning) return;
            
            let touchEndX = e.changedTouches[0].screenX;
            let touchEndY = e.changedTouches[0].screenY;
            
            handleSwipe(touchStartX, touchStartY, touchEndX, touchEndY);
        }, {passive: false});

        function handleSwipe(sx, sy, ex, ey) {
            const dx = ex - sx;
            const dy = ey - sy;
            
            if (Math.abs(dx) > Math.abs(dy)) {
                if (dx > 0) handleMobileInput('ArrowRight');
                else handleMobileInput('ArrowLeft');
            } else {
                if (dy > 0) handleMobileInput('ArrowDown');
                else handleMobileInput('ArrowUp');
            }
        }

        function handleMobileInput(key) {
            keyPush({ key: key });
        }

        function startGame() {
            startScreen.classList.add('hidden');
            resetGame();
        }

        function resetGame() {
            gameOverScreen.classList.add('hidden');
            player = { x: 10, y: 10 };
            trail = [];
            tailLength = 5;
            score = 0;
            scoreEl.innerText = score;
            velocity = { x: 1, y: 0 }; // Start moving right
            lastVelocity = { x: 1, y: 0 };
            gameSpeed = 100;
            placeApple();
            
            if (gameInterval) clearInterval(gameInterval);
            isGameRunning = true;
            gameInterval = setInterval(gameLoop, gameSpeed);
        }

        function gameLoop() {
            // Move Player
            player.x += velocity.x;
            player.y += velocity.y;

            // Record last velocity for this frame
            lastVelocity = { ...velocity };

            // Wall Collision (Wrap around style)
            if (player.x < 0) player.x = tileCount - 1;
            if (player.x > tileCount - 1) player.x = 0;
            if (player.y < 0) player.y = tileCount - 1;
            if (player.y > tileCount - 1) player.y = 0;

            // Background
            ctx.fillStyle = 'rgba(0, 0, 0, 0.8)'; // Slight trail effect if opacity < 1
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            // Draw Apple
            // Glow effect
            ctx.shadowBlur = 15;
            ctx.shadowColor = "#ff00ff";
            ctx.fillStyle = "#ff00ff";
            ctx.beginPath();
            // Draw a slightly rounded rect for style
            ctx.roundRect(apple.x * gridSize + 2, apple.y * gridSize + 2, gridSize - 4, gridSize - 4, 4);
            ctx.fill();
            ctx.shadowBlur = 0; // Reset shadow for other elements if needed

            // Draw Snake
            ctx.shadowBlur = 10;
            ctx.shadowColor = "#39ff14";
            ctx.fillStyle = "#39ff14";
            
            for (let i = 0; i < trail.length; i++) {
                // Head is brighter/different
                if (i === trail.length - 1) {
                    ctx.fillStyle = "#ccffcc";
                } else {
                    ctx.fillStyle = "#39ff14";
                }
                
                ctx.fillRect(trail[i].x * gridSize, trail[i].y * gridSize, gridSize - 2, gridSize - 2);

                // Self Collision Check
                if (trail[i].x === player.x && trail[i].y === player.y) {
                    gameOver();
                }
            }

            // Update Trail
            trail.push({ x: player.x, y: player.y });
            while (trail.length > tailLength) {
                trail.shift();
            }

            // Eat Apple
            if (apple.x === player.x && apple.y === player.y) {
                tailLength++;
                score += 10;
                scoreEl.innerText = score;
                
                // Speed up slightly every 50 points
                if (score % 50 === 0 && gameSpeed > 50) {
                    clearInterval(gameInterval);
                    gameSpeed -= 5;
                    gameInterval = setInterval(gameLoop, gameSpeed);
                }
                
                placeApple();
            }
        }

        function placeApple() {
            // Ensure apple doesn't spawn on snake body
            let valid = false;
            while (!valid) {
                apple.x = Math.floor(Math.random() * tileCount);
                apple.y = Math.floor(Math.random() * tileCount);
                
                valid = true;
                for (let t of trail) {
                    if (t.x === apple.x && t.y === apple.y) {
                        valid = false;
                        break;
                    }
                }
            }
        }

        function gameOver() {
            isGameRunning = false;
            clearInterval(gameInterval);
            gameOverScreen.classList.remove('hidden');
        }

        function keyPush(evt) {
            if (!isGameRunning) return;

            // Prevent reversing directly
            switch (evt.key) {
                case "ArrowLeft":
                case "a":
                case "A":
                    if (lastVelocity.x !== 1) velocity = { x: -1, y: 0 };
                    break;
                case "ArrowUp":
                case "w":
                case "W":
                    if (lastVelocity.y !== 1) velocity = { x: 0, y: -1 };
                    break;
                case "ArrowRight":
                case "d":
                case "D":
                    if (lastVelocity.x !== -1) velocity = { x: 1, y: 0 };
                    break;
                case "ArrowDown":
                case "s":
                case "S":
                    if (lastVelocity.y !== -1) velocity = { x: 0, y: 1 };
                    break;
            }
        }
    </script>
</body>
</html>
